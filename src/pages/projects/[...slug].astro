---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatDate, publicUrl } from '../../utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, date, kind, role, tags, cover, coverAlt, media, repo, links } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary} image={cover.src}>
  <article class="wrap project">
    <a class="back" href="/">&larr; All projects</a>

    <h1>{title}</h1>
    <p class="lede">{summary}</p>

    <ul class="meta">
      <li><strong>Date</strong> {formatDate(date)}</li>
      {role && <li><strong>Role</strong> {role}</li>}
      {kind && <li><strong>Type</strong> {kind}</li>}
    </ul>

    {
      (repo || links.length > 0) && (
        <div class="actions">
          {repo && (
            <a class="button" href={repo} rel="noopener">
              View code on GitHub
            </a>
          )}
          {links.map((link) => (
            <a class="button secondary" href={link.url} rel="noopener">
              {link.label}
            </a>
          ))}
        </div>
      )
    }

    <Image class="cover" src={cover} alt={coverAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 44rem) 44rem, 100vw" loading="eager" />

    <div class="prose">
      <Content />
    </div>

    {
      media.length > 0 && (
        <section class="media" aria-label="Demos">
          {media.map((item) => (
            <figure>
              {item.type === 'image' && (
                <Image src={item.src} alt={item.alt} widths={[480, 800, 1200]} sizes="(min-width: 52rem) 33rem, 100vw" loading="lazy" />
              )}
              {item.type === 'gif' && <img src={publicUrl(item.src)} alt={item.alt} loading="lazy" decoding="async" />}
              {item.type === 'video' && (
                <video controls preload="metadata" playsinline poster={item.poster ? publicUrl(item.poster) : undefined}>
                  <source src={publicUrl(item.src)} type="video/mp4" />
                  <p>
                    Your browser can't play this video. <a href={publicUrl(item.src)}>Download it</a>.
                  </p>
                </video>
              )}
              {(item.caption ?? (item.type !== 'video' ? item.alt : undefined)) && (
                <figcaption>{item.caption ?? (item.type !== 'video' ? item.alt : undefined)}</figcaption>
              )}
            </figure>
          ))}
        </section>
      )
    }

    {
      tags.length > 0 && (
        <div class="badges tags">
          {tags.map((tag) => (
            <span class="badge">{tag}</span>
          ))}
        </div>
      )
    }
  </article>

  <script>
    // Renders ```mermaid fenced code blocks (see "Inline pictures" section of the template
    // for how a project's Markdown works). Only downloads the mermaid library when a page
    // actually contains one.
    const blocks = document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]');
    if (blocks.length > 0) {
      const { default: mermaid } = await import('mermaid');
      const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default', securityLevel: 'strict' });

      let i = 0;
      for (const pre of blocks) {
        const source = [...pre.querySelectorAll('.line')].map((line) => line.textContent).join('\n');
        const container = document.createElement('div');
        container.className = 'mermaid-diagram';
        pre.replaceWith(container);
        const { svg } = await mermaid.render(`mermaid-${i++}`, source);
        container.innerHTML = svg;
      }
    }
  </script>
</Base>
