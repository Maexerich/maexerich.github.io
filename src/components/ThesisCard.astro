---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils';
import CoverVideo from './CoverVideo.astro';

interface Props {
  thesis: CollectionEntry<'theses'>;
}

const { thesis } = Astro.props;
const { title, summary, cover, coverAlt, kind, institution, tags, date } = thesis.data;
---

<a class="card" href={`/theses/${thesis.id}/`}>
  {
    typeof cover === 'string' ? (
      <CoverVideo src={cover} label={coverAlt ?? title} mode="hover" />
    ) : (
      cover && (
        <Image src={cover} alt={coverAlt ?? ''} widths={[400, 640, 900]} sizes="(min-width: 68rem) 21rem, (min-width: 40rem) 45vw, 100vw" loading="lazy" />
      )
    )
  }
  <div class="card-body">
    <h2>{title}</h2>
    <p>{summary}</p>
    <div class="badges">
      <span class="badge kind">{kind}</span>
      <span class="badge">{formatDate(date)}</span>
      {institution && <span class="badge">{institution}</span>}
      {tags.map((tag) => <span class="badge">{tag}</span>)}
    </div>
  </div>
</a>
